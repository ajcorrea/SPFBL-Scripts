#
# spfbl-firewall-update — Atualizador de Firewall SPFBL
# Compatível com iptables e nftables
#
# Original: Leandro Carlos Rodrigues <leandro@spfbl.net>
# Contribuição: Luciano Zanita <lucianozanita@advenhost.com.br>
# Compatibilidade nftables: Alexandre Jeronimo Correa <alexandre@ontelecom.io / ajcorrea@gmail.com>
#

FWTYPE=iptables

SPFBL_FIREWALL="/usr/local/bin/spfbl-firewall"
SPFBL_UPDATE="/usr/local/bin/spfbl-firewall-update"
CRON_LINK="/etc/cron.hourly/spfbl-firewall-update"
MATRIX_HOST="matrix4.spfbl.net"
MATRIX_PORT="9877"

#
# Verificando dependências
#
if [ "$FWTYPE" = "iptables" ]; then
    command -v nc >/dev/null 2>&1 || exit 1

elif [ "$FWTYPE" = "nftables" ]; then
    command -v nc >/dev/null 2>&1 || exit 1
    command -v nft >/dev/null 2>&1 || exit 1
    command -v python3 >/dev/null 2>&1 || exit 1

else
    echo "FWTYPE inválido: $FWTYPE"
    exit 1
fi

#
# Gerando lista de Firewall
#
TMPFILE=$(mktemp)

if ! echo "FIREWALL" | nc -w 60 "$MATRIX_HOST" "$MATRIX_PORT" > "$TMPFILE"; then
    rm -f "$TMPFILE"
    exit 1
fi

if [ ! -s "$TMPFILE" ]; then
    rm -f "$TMPFILE"
    exit 1
fi

#
# ============================================================
# IPTABLES
#
# O conteúdo retornado pelo MATRIX é usado diretamente.
#
# Isso inclui:
#   - IPv4 através de iptables
#   - IPv6 através de ip6tables
#
# ============================================================
#
if [ "$FWTYPE" = "iptables" ]; then

    rm -f "$SPFBL_FIREWALL"

    cp "$TMPFILE" "$SPFBL_FIREWALL"

    chmod +x "$SPFBL_FIREWALL"

    rm -f "$TMPFILE"

#
# ============================================================
# NFTABLES
#
# Converte as regras retornadas pelo MATRIX para nftables nativo.
#
# IPv4:
#   table ip spfbl
#
# IPv6:
#   table ip6 spfbl6
#
# ============================================================
#
elif [ "$FWTYPE" = "nftables" ]; then

    rm -f "$SPFBL_FIREWALL"

    #
    # Cabeçalho
    #
    cat > "$SPFBL_FIREWALL" <<'EOF'
#!/bin/bash

NFT="/usr/sbin/nft"

#
# Remove as tabelas anteriores para garantir que o estado
# local seja exatamente o recebido do MATRIX.
#
$NFT delete table ip spfbl 2>/dev/null || true
$NFT delete table ip6 spfbl6 2>/dev/null || true

#
# Cria tabelas
#
$NFT add table ip spfbl
$NFT add table ip6 spfbl6

#
# Cria chains
#
$NFT 'add chain ip spfbl SPFBL { type filter hook input priority -5; policy accept; }'
$NFT 'add chain ip6 spfbl6 SPFBL { type filter hook input priority -5; policy accept; }'

EOF

    #
    # ========================================================
    # Descobre as listas IPv4
    # ========================================================
    #
    IPV4_LISTS=$(
        grep -E '^[[:space:]]*iptables([[:space:]]|$).*--name SPFBL[0-9]+' "$TMPFILE" \
        | grep -oE -- '--name SPFBL[0-9]+' \
        | sed 's/.*--name //' \
        | sort -u -V
    )

    #
    # Cria os sets IPv4
    #
    for NAME in $IPV4_LISTS; do

        cat >> "$SPFBL_FIREWALL" <<EOF
\$NFT 'add set ip spfbl ${NAME} { type ipv4_addr; flags interval,timeout; }'
EOF

    done

    #
    # ========================================================
    # Descobre as listas IPv6
    # ========================================================
    #
    IPV6_LISTS=$(
        grep -E '^[[:space:]]*ip6tables([[:space:]]|$).*--name SPFBL[0-9]+' "$TMPFILE" \
        | grep -oE -- '--name SPFBL[0-9]+' \
        | sed 's/.*--name //' \
        | sort -u -V
    )

    #
    # Cria os sets IPv6
    #
    for NAME in $IPV6_LISTS; do

        cat >> "$SPFBL_FIREWALL" <<EOF
\$NFT 'add set ip6 spfbl6 ${NAME} { type ipv6_addr; flags interval,timeout; }'
EOF

    done

    #
    # ========================================================
    # Processa todas as regras retornadas pelo MATRIX
    # ========================================================
    #
    while IFS= read -r LINE; do

        #
        # Ignora linhas vazias
        #
        [ -z "$LINE" ] && continue

        #
        # ====================================================
        # IPv4
        # ====================================================
        #
        if echo "$LINE" | grep -Eq '^[[:space:]]*iptables([[:space:]]|$)'; then

            #
            # -----------------------------------------------
            # IPv4 --rcheck
            # -----------------------------------------------
            #
            if echo "$LINE" | grep -q -- '--rcheck'; then

                NAME=$(echo "$LINE" \
                    | sed -n 's/.*--name \(SPFBL[0-9]\+\).*/\1/p')

                if [ -n "$NAME" ]; then

                    cat >> "$SPFBL_FIREWALL" <<EOF
\$NFT 'add rule ip spfbl SPFBL tcp dport 25 ct state new ip saddr @${NAME} counter drop'
EOF

                fi

            #
            # -----------------------------------------------
            # IPv4 --set
            # -----------------------------------------------
            #
            elif echo "$LINE" | grep -q -- '--set'; then

                IP=$(echo "$LINE" \
                    | sed -n 's/.*-s \([0-9.]\+\).*/\1/p')

                NAME=$(echo "$LINE" \
                    | sed -n 's/.*--name \(SPFBL[0-9]\+\).*/\1/p')

                MASK=$(echo "$LINE" \
                    | sed -n 's/.*--mask \([0-9.]\+\).*/\1/p')

                if [ -n "$IP" ] && [ -n "$NAME" ] && [ -n "$MASK" ]; then

                    NETWORK=$(python3 - "$IP" "$MASK" <<'PY'
import sys
import ipaddress

ip = sys.argv[1]
mask = sys.argv[2]

try:
    network = ipaddress.IPv4Network(
        f"{ip}/{mask}",
        strict=False
    )

    print(network.network_address)

except Exception:
    sys.exit(1)
PY
)

                    if [ -n "$NETWORK" ]; then

                        cat >> "$SPFBL_FIREWALL" <<EOF
\$NFT 'add element ip spfbl ${NAME} { ${NETWORK} timeout 10m }'
EOF

                    fi

                fi

            fi

        #
        # ====================================================
        # IPv6
        # ====================================================
        #
        elif echo "$LINE" | grep -Eq '^[[:space:]]*ip6tables([[:space:]]|$)'; then

            #
            # -----------------------------------------------
            # IPv6 --rcheck
            # -----------------------------------------------
            #
            if echo "$LINE" | grep -q -- '--rcheck'; then

                NAME=$(echo "$LINE" \
                    | sed -n 's/.*--name \(SPFBL[0-9]\+\).*/\1/p')

                if [ -n "$NAME" ]; then

                    cat >> "$SPFBL_FIREWALL" <<EOF
\$NFT 'add rule ip6 spfbl6 SPFBL tcp dport 25 ct state new ip6 saddr @${NAME} counter drop'
EOF

                fi

            #
            # -----------------------------------------------
            # IPv6 --set
            # -----------------------------------------------
            #
            elif echo "$LINE" | grep -q -- '--set'; then

                IP=$(echo "$LINE" \
                    | sed -n 's/.*-s \([^ ]\+\).*/\1/p')

                NAME=$(echo "$LINE" \
                    | sed -n 's/.*--name \(SPFBL[0-9]\+\).*/\1/p')

                MASK=$(echo "$LINE" \
                    | sed -n 's/.*--mask \([^ ]\+\).*/\1/p')

                if [ -n "$IP" ] && [ -n "$NAME" ] && [ -n "$MASK" ]; then

                    NETWORK=$(python3 - "$IP" "$MASK" <<'PY'
import sys
import ipaddress

ip = sys.argv[1]
mask = sys.argv[2]

try:
    #
    # Aceita máscara em formato de prefixo:
    #   64
    #   48
    #   128
    #
    if mask.isdigit():
        network = ipaddress.IPv6Network(
            f"{ip}/{mask}",
            strict=False
        )

    #
    # Aceita máscara IPv6 completa:
    #   ffff:ffff:ffff:ffff::
    #
    else:
        network = ipaddress.IPv6Network(
            f"{ip}/{mask}",
            strict=False
        )

    print(network.network_address)

except Exception:
    sys.exit(1)
PY
)

                    if [ -n "$NETWORK" ]; then

                        #
                        # Obtém o prefixo para gerar corretamente
                        # o elemento do set nftables.
                        #
                        PREFIX=$(python3 - "$IP" "$MASK" <<'PY'
import sys
import ipaddress

ip = sys.argv[1]
mask = sys.argv[2]

try:
    if mask.isdigit():
        network = ipaddress.IPv6Network(
            f"{ip}/{mask}",
            strict=False
        )
    else:
        network = ipaddress.IPv6Network(
            f"{ip}/{mask}",
            strict=False
        )

    print(network.prefixlen)

except Exception:
    sys.exit(1)
PY
)

                        if [ -n "$PREFIX" ]; then

                            cat >> "$SPFBL_FIREWALL" <<EOF
\$NFT 'add element ip6 spfbl6 ${NAME} { ${NETWORK}/${PREFIX} timeout 10m }'
EOF

                        fi

                    fi

                fi

            fi

        fi

    done < "$TMPFILE"

    #
    # ========================================================
    # Limite de conexões simultâneas IPv4 por /24
    #
    # Equivalente a:
    #
    # --connlimit-above 8 --connlimit-mask 24
    #
    # ========================================================
    #
    cat >> "$SPFBL_FIREWALL" <<'EOF'

$NFT 'add rule ip spfbl SPFBL tcp dport 25 ct state new meter SPFBL_CONN_LIMIT { ip saddr & 255.255.255.0 ct count over 8 } counter reject with tcp reset'

EOF

    #
    # ========================================================
    # Limite de conexões simultâneas IPv6 por /64
    #
    # Equivalente à lógica de agrupamento IPv6 por /64.
    # ========================================================
    #
    cat >> "$SPFBL_FIREWALL" <<'EOF'

$NFT 'add rule ip6 spfbl6 SPFBL tcp dport 25 ct state new meter SPFBL6_CONN_LIMIT { ip6 saddr & ffff:ffff:ffff:ffff:: ct count over 8 } counter reject with tcp reset'

exit 0
EOF

    #
    # Permissão
    #
    chmod +x "$SPFBL_FIREWALL"

    rm -f "$TMPFILE"

fi

#
# ============================================================
# Verifica se já existe o atalho para o cron de 1H
# ============================================================
#
if [ -e "$CRON_LINK" ]; then
    :
else
    ln -s "$SPFBL_UPDATE" "$CRON_LINK"
    chmod +x "$CRON_LINK"
fi

#
# ============================================================
# Verificando se o cliente possui CSF
# ============================================================
#
if [ -d "/etc/csf/" ]; then

    #
    # Verificando se o cliente já possui o csfpost
    #
    if [ -e "/etc/csf/csfpost.sh" ]; then

        if grep -Fxq "$SPFBL_FIREWALL" "/etc/csf/csfpost.sh"; then
            :
        else
            sed -i -e '$a\'"$SPFBL_FIREWALL" "/etc/csf/csfpost.sh"
        fi

    else

        echo '#!/bin/bash' > "/etc/csf/csfpost.sh"
        echo "$SPFBL_FIREWALL" >> "/etc/csf/csfpost.sh"

    fi

    chmod +x "/etc/csf/csfpost.sh"

fi

#
# ============================================================
# Executa o Firewall para atualização
# ============================================================
#
"$SPFBL_FIREWALL" > /dev/null 2>&1

exit 0
