#!/bin/bash
#
# spfbl-firewall-update — Atualizador de Firewall SPFBL (compatível com nftables)
# Suporta:
#   - iptables-legacy  (AlmaLinux ≤9)
#   - iptables-nft     (AlmaLinux 10 — wrapper que usa nf_tables internamente)
#   - nftables puro    (AlmaLinux 10+ sem pacote iptables)
#
# A chain SPFBL é exclusivamente estática: vem do servidor matrix via netcat.
# Não há daemon inserindo regras dinamicamente — a chain é simplesmente
# recriada a cada execução do cron.
#
# Original: Leandro Carlos Rodrigues <leandro@spfbl.net>
# Contribuição: Luciano Zanita <lucianozanita@advenhost.com.br>
# Compatibilidade nftables: Alexandre Jeronimo Correa <alexandre@ontelecom.io / ajcorrea@gmail.com>
#

SPFBL_BIN="/usr/local/bin/spfbl-firewall"
SPFBL_IPT="/usr/local/bin/spfbl-firewall.ipt"
CRON_LINK="/etc/cron.hourly/spfbl-firewall-update"
NFTABLES_CONF="/etc/sysconfig/nftables.conf"
TMPRAW=$(mktemp /tmp/spfbl-raw.XXXXXX)
trap 'rm -f "$TMPRAW"' EXIT

# ─────────────────────────────────────────────────────────────────────────────
# 1. Detectar backend (3 casos, resolvidos aqui no update, não no gerado)
# ─────────────────────────────────────────────────────────────────────────────
# legacy      : iptables-legacy — pode executar o .ipt diretamente
# nft_wrapper : iptables-nft instalado — aceita comandos iptables mas traduz
#               -m recent / -m connlimit para "xt match" no nftables, que NÃO
#               pode ser recarregado pelo nftables.service → tratar como nft
# nft         : sem iptables — nftables puro
if iptables --version 2>/dev/null | grep -q 'nf_tables'; then
    HOST_BACKEND="nft_wrapper"
elif iptables -w -S >/dev/null 2>&1; then
    HOST_BACKEND="legacy"
else
    HOST_BACKEND="nft"
fi

# ─────────────────────────────────────────────────────────────────────────────
# 2. Baixar script bruto do servidor SPFBL
# ─────────────────────────────────────────────────────────────────────────────
echo "FIREWALL" | nc -w 60 matrix4.spfbl.net 9877 > "$TMPRAW"

if [ ! -s "$TMPRAW" ] || ! grep -q 'iptables' "$TMPRAW" 2>/dev/null; then
    echo "[spfbl] ERRO: resposta inválida ou vazia do servidor SPFBL." >&2
    exit 1
fi

cp "$TMPRAW" "$SPFBL_IPT"
chmod +x "$SPFBL_IPT"

# ─────────────────────────────────────────────────────────────────────────────
# 3. Cron link
# ─────────────────────────────────────────────────────────────────────────────
if [ ! -e "$CRON_LINK" ]; then
    ln -sf /usr/local/bin/spfbl-firewall-update "$CRON_LINK"
    chmod +x "$CRON_LINK"
fi

# ─────────────────────────────────────────────────────────────────────────────
# 4. Integração CSF
# ─────────────────────────────────────────────────────────────────────────────
if [ -d /etc/csf/ ]; then
    if [ -e /etc/csf/csfpost.sh ]; then
        grep -Fxq "$SPFBL_BIN" /etc/csf/csfpost.sh || \
            echo "$SPFBL_BIN" >> /etc/csf/csfpost.sh
    else
        printf '#!/bin/bash\n%s\n' "$SPFBL_BIN" > /etc/csf/csfpost.sh
    fi
    chmod +x /etc/csf/csfpost.sh
fi

# ─────────────────────────────────────────────────────────────────────────────
# 5. Parser: extrair valores do script baixado
# ─────────────────────────────────────────────────────────────────────────────
PORT4=$(grep 'iptables.*INPUT.*--dport' "$TMPRAW" | \
        grep -oP -- '--dport \K\d+' | head -1)
PORT4=${PORT4:-25}
PORT6=$PORT4

TIMEOUT=$(grep 'iptables.*--seconds' "$TMPRAW" | \
          grep -oP -- '--seconds \K\d+' | head -1)
TIMEOUT=${TIMEOUT:-600}

CL4_ABOVE=$(grep -v ip6 "$TMPRAW" | grep -m1 'connlimit-above' | \
            grep -oP -- '--connlimit-above \K\d+')
CL4_MASK=$(grep  -v ip6 "$TMPRAW" | grep -m1 'connlimit-mask' | \
           grep -oP -- '--connlimit-mask \K\d+')
CL4_ABOVE=${CL4_ABOVE:-8}
CL4_MASK=${CL4_MASK:-24}

CL6_ABOVE=$(grep -m1 'ip6tables.*connlimit-above' "$TMPRAW" | \
            grep -oP -- '--connlimit-above \K\d+')
CL6_MASK=$(grep  -m1 'ip6tables.*connlimit-mask'  "$TMPRAW" | \
           grep -oP -- '--connlimit-mask \K\d+')
CL6_ABOVE=${CL6_ABOVE:-8}
CL6_MASK=${CL6_MASK:-48}

# Arrays "NOME_SET:MASCARA" para IPv4 e IPv6
mapfile -t IPV4_RECENT < <(
    grep 'iptables' "$TMPRAW" | grep -v ip6 | grep 'recent.*--rcheck' |
    sed -E 's/.*--name[[:space:]]+([^[:space:]]+)[[:space:]]+--mask[[:space:]]+([^[:space:]]+).*/\1:\2/'
)
mapfile -t IPV6_RECENT < <(
    grep 'ip6tables' "$TMPRAW" | grep 'recent.*--rcheck' |
    sed -E 's/.*--name[[:space:]]+([^[:space:]]+)[[:space:]]+--mask[[:space:]]+([^[:space:]]+).*/\1:\2/'
)

META_CLIENT=$(grep  '^# Client:'   "$TMPRAW" | head -1)
META_CREATION=$(grep '^# Creation:' "$TMPRAW" | head -1)

# ─────────────────────────────────────────────────────────────────────────────
# 6. Helpers: CIDR → máscara (necessário para meter nft — não aceita /24)
# ─────────────────────────────────────────────────────────────────────────────
cidr4_to_mask() {
    local bits=$1 mask=0 i
    for ((i=0; i<bits; i++)); do mask=$(( mask | (1 << (31-i)) )); done
    printf '%d.%d.%d.%d' \
        $(( (mask>>24)&255 )) $(( (mask>>16)&255 )) \
        $(( (mask>> 8)&255 )) $((  mask     &255 ))
}

cidr6_to_mask() {
    local bits=$1 i g b
    local -a grp=(0 0 0 0 0 0 0 0)
    for ((i=0; i<bits; i++)); do
        g=$(( i/16 )); b=$(( 15 - i%16 ))
        grp[$g]=$(( grp[$g] | (1<<b) ))
    done
    local r=""
    for g in "${grp[@]}"; do r+=$(printf '%x:' "$g"); done
    echo "${r%:}"
}

# ─────────────────────────────────────────────────────────────────────────────
# 7. Funções emit_nft*: geram regras nftables nativas (sem xt compat)
#    Sem SPFBL_BLOCKED — a chain é exclusivamente estática (não há daemon)
# ─────────────────────────────────────────────────────────────────────────────

emit_nft4_init() {
    echo "add table ip spfbl"
    echo "add chain ip spfbl SPFBL { type filter hook input priority 0; policy accept; }"
    for e in "${IPV4_RECENT[@]}"; do
        local n="${e%%:*}"
        echo "add set ip spfbl ${n} { type ipv4_addr; flags dynamic,timeout; timeout ${TIMEOUT}s; }"
    done
    local _cl4m; _cl4m=$(cidr4_to_mask "$CL4_MASK")
    echo "add rule ip spfbl SPFBL tcp dport ${PORT4} meter spfbl4_cl size 65536 { ip saddr and ${_cl4m} ct count over ${CL4_ABOVE} } reject with tcp reset"
    for e in "${IPV4_RECENT[@]}"; do
        local n="${e%%:*}" m="${e#*:}"
        echo "add rule ip spfbl SPFBL tcp dport ${PORT4} ip saddr & ${m} @${n} drop"
    done
    for e in "${IPV4_RECENT[@]}"; do
        local n="${e%%:*}" m="${e#*:}"
        echo "add rule ip spfbl SPFBL tcp dport ${PORT4} ct state new update @${n} { ip saddr & ${m} timeout ${TIMEOUT}s }"
    done
}

emit_nft4_refresh() {
    # flush chain (equivale a iptables -F SPFBL) + flush sets + re-adiciona tudo
    echo "flush chain ip spfbl SPFBL"
    for e in "${IPV4_RECENT[@]}"; do
        local n="${e%%:*}"
        echo "flush set ip spfbl ${n}"
    done
    local _cl4m; _cl4m=$(cidr4_to_mask "$CL4_MASK")
    echo "add rule ip spfbl SPFBL tcp dport ${PORT4} meter spfbl4_cl size 65536 { ip saddr and ${_cl4m} ct count over ${CL4_ABOVE} } reject with tcp reset"
    for e in "${IPV4_RECENT[@]}"; do
        local n="${e%%:*}" m="${e#*:}"
        echo "add rule ip spfbl SPFBL tcp dport ${PORT4} ip saddr & ${m} @${n} drop"
    done
    for e in "${IPV4_RECENT[@]}"; do
        local n="${e%%:*}" m="${e#*:}"
        echo "add rule ip spfbl SPFBL tcp dport ${PORT4} ct state new update @${n} { ip saddr & ${m} timeout ${TIMEOUT}s }"
    done
}

emit_nft6_init() {
    echo "add table ip6 spfbl"
    echo "add chain ip6 spfbl SPFBL { type filter hook input priority 0; policy accept; }"
    for e in "${IPV6_RECENT[@]}"; do
        local n="${e%%:*}"
        echo "add set ip6 spfbl ${n} { type ipv6_addr; flags dynamic,timeout; timeout ${TIMEOUT}s; }"
    done
    local _cl6m; _cl6m=$(cidr6_to_mask "$CL6_MASK")
    echo "add rule ip6 spfbl SPFBL tcp dport ${PORT6} meter spfbl6_cl size 65536 { ip6 saddr and ${_cl6m} ct count over ${CL6_ABOVE} } reject with tcp reset"
    for e in "${IPV6_RECENT[@]}"; do
        local n="${e%%:*}" m="${e#*:}"
        echo "add rule ip6 spfbl SPFBL tcp dport ${PORT6} ip6 saddr & ${m} @${n} drop"
    done
    for e in "${IPV6_RECENT[@]}"; do
        local n="${e%%:*}" m="${e#*:}"
        echo "add rule ip6 spfbl SPFBL tcp dport ${PORT6} ct state new update @${n} { ip6 saddr & ${m} timeout ${TIMEOUT}s }"
    done
}

emit_nft6_refresh() {
    echo "flush chain ip6 spfbl SPFBL"
    for e in "${IPV6_RECENT[@]}"; do
        local n="${e%%:*}"
        echo "flush set ip6 spfbl ${n}"
    done
    local _cl6m; _cl6m=$(cidr6_to_mask "$CL6_MASK")
    echo "add rule ip6 spfbl SPFBL tcp dport ${PORT6} meter spfbl6_cl size 65536 { ip6 saddr and ${_cl6m} ct count over ${CL6_ABOVE} } reject with tcp reset"
    for e in "${IPV6_RECENT[@]}"; do
        local n="${e%%:*}" m="${e#*:}"
        echo "add rule ip6 spfbl SPFBL tcp dport ${PORT6} ip6 saddr & ${m} @${n} drop"
    done
    for e in "${IPV6_RECENT[@]}"; do
        local n="${e%%:*}" m="${e#*:}"
        echo "add rule ip6 spfbl SPFBL tcp dport ${PORT6} ct state new update @${n} { ip6 saddr & ${m} timeout ${TIMEOUT}s }"
    done
}

# ─────────────────────────────────────────────────────────────────────────────
# 8. nft_wrapper: remover chain iptables SPFBL antes de assumir com nft nativo
# ─────────────────────────────────────────────────────────────────────────────
# Execuções anteriores do script original criaram chain SPFBL via iptables-nft,
# que ficou traduzida como "xt match recent/connlimit" no nftables.
# Antes de aplicar as regras em nft nativo, removemos essa chain para evitar
# dupla aplicação e para eliminar as expressões xt compat do kernel.
if [ "$HOST_BACKEND" = "nft_wrapper" ]; then
    for ipt in iptables ip6tables; do
        if $ipt -w -L SPFBL -n >/dev/null 2>&1; then
            # Remove todos os saltos INPUT → SPFBL (pode haver mais de um)
            while $ipt -w -D INPUT -p tcp --dport "$PORT4" --syn \
                        -m state --state NEW -j SPFBL 2>/dev/null; do :; done
            $ipt -w -F SPFBL 2>/dev/null
            $ipt -w -X SPFBL 2>/dev/null
        fi
    done
fi

# ─────────────────────────────────────────────────────────────────────────────
# 9. Corrigir /etc/sysconfig/nftables.conf
# ─────────────────────────────────────────────────────────────────────────────
# Dois problemas que causam falha no "nftables.service restart":
#
# A) "File exists": o arquivo usa comandos "add set/table/chain" mas o
#    nftables.service NÃO faz flush automático antes de carregar o conf.
#    Se qualquer set (SPFBL, CPGuard, etc.) já existe no kernel → erro.
#    Solução: garantir que a primeira linha executável seja "flush ruleset",
#    que limpa o kernel antes de recarregar tudo.
#
# B) "xt match recent/connlimit": expressões de compatibilidade geradas pelo
#    iptables-nft quando o script original rodava. O nft nativo não consegue
#    recarregá-las. Solução: remover as linhas problemáticas.
if [ -f "$NFTABLES_CONF" ]; then
    _CHANGED=0

    # A) Garantir flush ruleset como primeira linha executável
    if ! grep -qE '^\s*flush\s+ruleset' "$NFTABLES_CONF" 2>/dev/null; then
        [ "$_CHANGED" -eq 0 ] && cp "$NFTABLES_CONF" "${NFTABLES_CONF}.bak-$(date +%Y%m%d%H%M%S)"
        _CHANGED=1
        sed -i '1s/^/flush ruleset\n/' "$NFTABLES_CONF"
        echo "[spfbl] Adicionado 'flush ruleset' ao início de $NFTABLES_CONF" >&2
    fi

    # B) Remover expressões xt compat SPFBL (apenas em sistemas nft_wrapper)
    if [ "$HOST_BACKEND" = "nft_wrapper" ] && \
       grep -qE 'xt match "(recent|connlimit)"' "$NFTABLES_CONF" 2>/dev/null; then
        [ "$_CHANGED" -eq 0 ] && cp "$NFTABLES_CONF" "${NFTABLES_CONF}.bak-$(date +%Y%m%d%H%M%S)"
        _CHANGED=1
        sed -i '/xt match "recent"/d; /xt match "connlimit"/d' "$NFTABLES_CONF"
        echo "[spfbl] Removidas expressões xt compat SPFBL de $NFTABLES_CONF" >&2
    fi

    [ "$_CHANGED" -eq 1 ] && echo "[spfbl] Backup salvo em ${NFTABLES_CONF}.bak-*" >&2
fi

# ─────────────────────────────────────────────────────────────────────────────
# 10. Gerar /usr/local/bin/spfbl-firewall (script dual-mode: legacy | nft)
# ─────────────────────────────────────────────────────────────────────────────
# O script gerado detecta o backend em tempo de execução:
#   legacy → executa spfbl-firewall.ipt (iptables puro, sem xt compat)
#   nft    → aplica via nft nativo (cobre tanto nft puro quanto nft_wrapper)
# ─────────────────────────────────────────────────────────────────────────────
{

printf '%s\n' '#!/bin/bash'
printf '%s\n' '#'
printf '%s\n' '# Firewall for SPFBL client — nftables compatible.'
printf '%s\n' '# Gerado automaticamente por spfbl-firewall-update.'
printf '%s\n' "# Geração: $(date -R)"
[ -n "$META_CLIENT"   ] && printf '%s\n' "$META_CLIENT"
[ -n "$META_CREATION" ] && printf '%s\n' "$META_CREATION"
printf '%s\n' '#'
printf '\n'

cat <<'DETECT_BLOCK'
# ── Detecção de backend ───────────────────────────────────────────────────────
# legacy : iptables-legacy verdadeiro → executa .ipt diretamente
# nft    : iptables-nft (wrapper) OU sem iptables → nft nativo completo
if ! iptables --version 2>/dev/null | grep -q 'nf_tables' && \
     iptables -w -S >/dev/null 2>&1; then
    _BACKEND="legacy"
else
    _BACKEND="nft"
fi

DETECT_BLOCK

cat <<'LEGACY_BLOCK'
if [ "$_BACKEND" = "legacy" ]; then
    bash /usr/local/bin/spfbl-firewall.ipt

LEGACY_BLOCK

cat <<'NFT_BLOCK'
else
    NFT=$(command -v nft 2>/dev/null || echo /usr/sbin/nft)
    NFTSCRIPT=$(mktemp /tmp/spfbl-nft.XXXXXX.nft)
    trap 'rm -f "$NFTSCRIPT"' EXIT

NFT_BLOCK

# -- IPv4 --
printf '%s\n' '    # ── IPv4 ──────────────────────────────────────────────────────────────────'
printf '%s\n' '    if ! $NFT list table ip spfbl >/dev/null 2>&1; then'
printf '%s\n' "        cat > \"\$NFTSCRIPT\" <<'__NFT4I__'"
emit_nft4_init
printf '%s\n' '__NFT4I__'
printf '%s\n' '        $NFT -f "$NFTSCRIPT"'
printf '%s\n' '    else'
printf '%s\n' "        cat > \"\$NFTSCRIPT\" <<'__NFT4R__'"
emit_nft4_refresh
printf '%s\n' '__NFT4R__'
printf '%s\n' '        $NFT -f "$NFTSCRIPT"'
printf '%s\n' '    fi'
printf '\n'

# -- IPv6 --
printf '%s\n' '    # ── IPv6 ──────────────────────────────────────────────────────────────────'
printf '%s\n' '    if ! $NFT list table ip6 spfbl >/dev/null 2>&1; then'
printf '%s\n' "        cat > \"\$NFTSCRIPT\" <<'__NFT6I__'"
emit_nft6_init
printf '%s\n' '__NFT6I__'
printf '%s\n' '        $NFT -f "$NFTSCRIPT"'
printf '%s\n' '    else'
printf '%s\n' "        cat > \"\$NFTSCRIPT\" <<'__NFT6R__'"
emit_nft6_refresh
printf '%s\n' '__NFT6R__'
printf '%s\n' '        $NFT -f "$NFTSCRIPT"'
printf '%s\n' '    fi'
printf '\n'

printf '%s\n' 'fi  # end _BACKEND'

} > "$SPFBL_BIN"

chmod +x "$SPFBL_BIN"

# ─────────────────────────────────────────────────────────────────────────────
# 11. Executar o firewall gerado (erros aparecem no log do cron)
# ─────────────────────────────────────────────────────────────────────────────
"$SPFBL_BIN"
